linters: list(
    object_name_linter(styles = c("camelCase", "CamelCase")),
    assignment_linter(),
    undesirable_function_linter(
      c(attach = "use with() or explicit references instead"))
  )
exclusions: list(
    # Generated by Rcpp::compileAttributes(): its style comes from the C++
    # side, and any annotation here is wiped by the next regeneration.
    "R/RcppExports.R"
  )
