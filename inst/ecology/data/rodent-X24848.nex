	Tsaganomys         101112?1111-111-030-?10001001031101111011122020111031-111-11-1-00201110301010211100000110100000001200010100200020000011010011000?1?021222210?0?1101010100?42110010?00??????????????1????????????????????????????????????????1
	Ukhaatherium       ??0000?0000100000201?01000111010000100000010010000?000010100000001001100000000010000001020010010000000100--0000000000?100010000????010000?0?0010110001000120000000010??00100000000?0?0000010??0---00011010000?1???0???000?0?1
	Zalambdalestes     ??0(0 2)11?010010(0 1)000201?010001110100001100000100000?1?0??1100(0 1)0000011000100000000011000001020010011000000000--000010000011000100101010010100(0 2)010010110000000120000000000010010010000??01100021110100001????0?0010?00000?100001?1

;

END;
BEGIN NOTES;

	TEXT   CHARACTER = 1 TEXT = '(M2, MW2; von Koenigswald, 1985; Martin, 2004) Hunter-Schraeger bands---(0) absent (e.g., Didelphis), (1) present (e.g., Cavia). We split character 2 used by Meng et al. (2003) into two separate characters (#1 and 2 listed here).';
	TEXT   TAXON = 34 CHARACTER = 1 TEXT = 'see table 8.2 in Koenigswald 2000 (chapter in Teaford & Smith) for summary of enamel types across marsupials';
	TEXT   TAXON = 60 CHARACTER = 1 TEXT = 'present in Vombatus incisors according to vonKoenigswald 1985: 405';
	TEXT   TAXON = 73 CHARACTER = 1 TEXT = 'see von Koenigswald 2004 J Mamm Ev 11(2):127-142';
	TEXT   TAXON = 77 CHARACTER = 1 TEXT = 'see von Koenigswald 2004 J Mamm Ev 11(2):127-142';

	TEXT   CHARACTER = 2 TEXT = '(M2, MW2; von Koenigswald, 1985; Martin, 2004) Hunter-Schraeger band layers---(0) multiple (e.g., Rattus), (1) single (e.g., Lepus).';

	TEXT   CHARACTER = 3 TEXT = 'Incisor shape---(0) root and incisor crown are straight and continuous in length (e.g., Didelphis), (1) root and crown form a continuous curve, in which for upper incisors the root leaves the alveolus directed anteriorly and the crown gradually bends back in a posterior direction (e.g., Cavia).';

	TEXT   CHARACTER = 4 TEXT = '(M22) Incisor compression---(0) conical (Didelphis), (1) anteroposteriorly compressed (e.g., Lepus), (2) transversely compressed (e.g., Cavia). State 3 "flat square" for Tsaganomys, Neoreomys and Incamys (coded in Meng et al. 2003 and Asher et al. 2005) is not distinguishable from AP-compressed and is therefore sunk into state 2 "AP compressed".';
	TEXT   TAXON = 76 CHARACTER = 4 TEXT = 'See fig. 4I, 4J in Vucetich et al. 2015 Historical Biology 27(2) ^nhttps://doi.org/10.1080/08912963.2014.883506';
	TEXT   TAXON = 100 CHARACTER = 4 TEXT = see_Fig._9_of_Bryant_&_McKenna_1995_AMNH_Novitates;

	TEXT   CHARACTER = 5 TEXT = '(M1, MW3) Enamel distribution in anterior lower dentition--(0) surrounds tooth (e.g., Didelphis), (1) discontinuous posteriorly (e.g., Cavia).';

	TEXT   CHARACTER = 16 TEXT = 'text from Meng et al. 2003: "Character 33: Third lower premolar"-?(0) with longitudinal main cusp, (1) with metaconid, (2) with transverse rudiment trigonid and talonid, or (3) enlarged with enamel folds (*27). Differing from Meng and Wyss (2001), we score an additional "-?"-?1"-?"-? for Phenacodus.';

	TEXT   CHARACTER = 19 TEXT = 'Meng et al. 2003:char 38: "Protostylid of p4"-(0) absent, or (1) present. The protostylid is a cingular cusp labial to the protoconid (Wood and Wilson, 1936). It occurs in Florentiamys and Gregorymys."';
	TEXT   TAXON = 73 CHARACTER = 19 TEXT = 'Korth 1991: 253 notes ambiguity about ID of protostylid vs. anterior cingulum. Hence, this is coded as polymorphic';

	TEXT   CHARACTER = 20 TEXT = 'from Asher et al. 2005, char 20: "p4 talonid shape---(0) simple or unbasined (e.g., Tupaia), (1) tricuspid (e.g., Leptictis) . Both Gomphos and Pseudictops are coded as "crested" in Meng and Wyss 2001 (char 30), but the p4 talonid in these taxa have a basin, with entocontid and hypoconids variably distinct, depending on wear, connected by ridges. Lagomorphs and Cavia, in contrast, show no talonid basin but are bilophodont, also coded as "crested" in Meng and Wyss (2001). In order to avoid overweighting the "crestiform" morphology, we code this character as inapplicable for taxa with state 3 ("ridged") for character 18 (p4 trigonid shape)."  Also some taxa with a basin may not be "tricuspate". Change states to unbasined (=simple) vs. basined.';

	TEXT   CHARACTER = 21 TEXT = 'based on molar enamel types summarized in Koenigswald 2004: table 1. P = radial enamel only, C = Cricetus type with basal ring of lamellar enamel, S = Sciurus type with thick HSB on molar sidewalls';
	TEXT   TAXON = 1 CHARACTER = 21 TEXT = 'Radial enamel given in Koenigswald 2000:table 8.2 for didelphids, corresponding to "P type" of Koenigswald 2004';
	TEXT   TAXON = 32 CHARACTER = 21 TEXT = 'See Markovic et al. 2018 (Palaeobio Palaeoenv (2018) 98:459–469) for S-type enamel in a fossil diatomyid. However they do not discuss type for Laonastes';
	TEXT   TAXON = 34 CHARACTER = 21 TEXT = 'Koenigswald 2000: table 8.2 notes a number of conditions for macropodids and it''s not possible based on that to rule out non-radial enamel for some of the molars.';
	TEXT   TAXON = 36 CHARACTER = 21 TEXT = 'ctenodactylids are listed as "secondarily modified" in Koenigswald 2004: table 1 without a type.';
	TEXT   TAXON = 73 CHARACTER = 21 TEXT = 'Koenigswald 2004: 133, "The Miocene geomyoid genera Heliscomys (KOE 1599) and Schizodontomys (KOE 300, 3270) are low crowned and have the BRLE as the geomyine Dikkomys (KOE 219). Thus, the geomyids are characterized by having the C-type schmelzmuster although several genera with evolved hypsodont or euhypsodont molars modified their schmelzmuster secondarily."';
	TEXT   TAXON = 87 CHARACTER = 21 TEXT = 'Koenigswald 2004 shows Eomyidae with "C-type" in his table 1. Korth identifies Pardijaumo as an eomyid';
	TEXT   TAXON = 88 CHARACTER = 21 TEXT = 'Koenigswald 2004 shows "Ischyromyoidea" with "(P) S-type" in his table 1, which follows McKenna & Bell 1997, including Paramys within "Ischyromyoidea". It''s unclear what the "(P)" in his table 1 means so this is scored "?"';
	TEXT   TAXON = 94 CHARACTER = 21 TEXT = 'Koenigswald 2004:131';
	TEXT   TAXON = 96 CHARACTER = 21 TEXT = 'Koenigswald 2004: 131, "In the fossil Sciuravida, the P-type schmelzmuster was found in the late Eocene Cylindrodon (KOE 1572) from Wyoming (Fig. 1a) while other cylindrodontids show a S-type schmelzmuster."^np. 133: "In the Sciuravida families Sciuravidae, Chapattimyidae, and Cylidrodontidae, the S type schmelzmuster is dominantly present, but in the late Eocene Cylindrodon (KOE1572) from Wyoming only radial enamel was detected."^nBased on the above Sciuravus is scored as "S" type';
	TEXT   TAXON = 99 CHARACTER = 21 TEXT = 'Koenigswald 2004: 129-131, "The origin of rodents is still under debate, but Alagomys (KOE 3685) (Fig. 2) and Tribosphneomys from the late Paleocene of China and North America may be close to it... Their molars are formed by radial enamel only."^nHence Tribosphenomys scored as "P" type';

	TEXT   CHARACTER = 22 TEXT = 'Asher et al. 2005:suppdata char 21: ''(ordered; M50, MW34) Cheek teeth height---(0) brachydont (e.g., Didelphis), (1) unilaterally hypsodont (e.g., Gomphos), (2) hypsodont (e.g., Lepus). We subsume state 2 "some hypsodont" of Meng et al. (2003: character 50) into state "hypsodont". We define "unilaterally hypsodont" as enamel extending into alveolus lingually (e.g., Gomphos).''';

	TEXT   CHARACTER = 24 TEXT = 'Meng et al. 2003 char 66 use this character in reference to m1: "Cusps labial to protoconid on m1"';

	TEXT   CHARACTER = 25 TEXT = 'from Meng et al. 2003: char 71, "Ectolophid"-?(0) present, or (1) absent. The ectolophid is the ridge from the protoconid to hypoconid, near the^nlabial side of the tooth (Wood and Wilson, 1936). It is considered homologous with the cristid obliqua of nongliroid mammals (Meng and Wyss, 2001). This ridge may be lost in various forms such as lagomorphs, murids, and geomyoids."';

	TEXT   CHARACTER = 28 TEXT = '"Anteroconid" was previously coded by Asher et al. 2005, Meng et al. 2003, and most 20th century rodent paleontologists as a distinct cusp from "paraconid". Broadly speaking, the mammalian "paraconid" and the muroid "anteroconid" are distinguished based on a priori homology assumptions about rodent evolution. In fact, an assessment of anatomical, primary homology (without assuming that muroids evolved from other mammals without paraconids) would require merging these two characters. Here, we change the name from "anteroconid" to "paraconid" with same states as "anteroconid"; code as state 1 ("single") anything coded as "present" for paraconid; and delete char M77 "paraconid"';

	TEXT   CHARACTER = 30 TEXT = 'from Meng et al. 2003, char 79 "Mesoconid of lower molar"-?(0) absent, or (1) present. The mesoconid is a cusp on the ectolophid in the median valley (Wood and Wilson, 1936)."';

	TEXT   CHARACTER = 31 TEXT = 'from Asher et al. 2005: char 31, suppdata, "Character 31 (M80, MW53) lower molar talonid basin---(0) indistinct (e.g., Dipodomys), (1) broad (e.g., Didelphis), (2) filled entoconid (e.g., Mus), (3) filled hypolophid (e.g., Castor), (4) bilophodont (e.g., Macropus). We redefine state 0 as "indistinct" for taxa in which the talonid is incorporated into the trigonid (Wahlert, pers. comm), or is otherwise reduced. State 1 (broad trigonid) incorporates the morphology seen in non-glires such as Didelphis. States 2 and 3 are retained from Meng et al. (2003), and state 4 is used here for bilophodont taxa (e.g., Macropus), in which the talonid is unbasined with a transverse ridge."';

	TEXT   CHARACTER = 33 TEXT = 'Meng et al. 2003: char 82, ''Hypolophid of lower molar"-?(0) absent, (1) present, or (2) very strong. The hypolophid (also called hypolophulid) is primitively absent. When present, the ridge usually extends from the entoconid to the hypoconid or to the ectolophid anterior to the hypoconid. The hypolophid is usually strong in hystricognath rodents.'' "Very strong" is defined as comprising a posterior crest of the lower molar, not just a loph running labial from a distinct entoconid (as illustrated in Marivaux et al. 2004:fig. 1).';

	TEXT   CHARACTER = 38 TEXT = 'Meng & Wyss 2001:43 (their char 69) "If measured from the turning point where the ascending ramus arises from the horizontal ramus to the anterior tip of the mandible, the horizontal ramus is usually much longer than the total length of the three molars of the same individual specimen, and the mandible depth is one to two times the length of m1 in the primitive condition [STATE 0]. In the derived condition, the horizontal ramus is roughly twice as long as the length of the molar row, and its depth is about three times the length of m1 [STATE 1]."';

	TEXT   CHARACTER = 39 TEXT = 'from Asher et al. 2005: suppdata, "(M86, MW69) mandibular symphysis---(0) tapered (e.g., Didelphis), (1) deep (e.g,., Adapis ). Following Meng and Wyss (2001: character 69), state "deep" represents a dorso-ventrally oriented symphysis, housing the canine and/or incisor root; state "tapered" represents an anteroposteriorly oriented symphysis.';

	TEXT   CHARACTER = 40 TEXT = 'from Asher et al. 2005:suppdata, "(M88, MW70) coronoid process---(0) large, surface area exceeds that of mandibular condyle (e.g., Didelphis), (1) surface area similar to or smaller than mandibular condyle (e.g., Marmota), (2) small and present lateral to m3 (e.g., Cavia), (3) absent (e.g., Lepus). We subsume states 1 ("somewhat reduced") and 2 ("greatly reduced but still as high as mandibular condyle") from Meng et al. (2003) into our state 1.';
	TEXT   TAXON = 68 CHARACTER = 40 TEXT = 'coded based on fig. 3 from Emry RJ, Korth WW. The Chadronian squirrel “Sciurus” jeffersoni Douglass, 1901: a new generic name, new material, and its bearing on the early evolution of Sciuridae (Rodentia). Journal of Vertebrate Paleontology. 1996 Dec 31;16(4):775-80.';

	TEXT   CHARACTER = 41 TEXT = 'from Asher et al. 2005: suppdata, "...(M89, MW71) angular process size---(0) small, tip does not taper appreciably vs. base (e.g., Petrodromus), (1) large, base much wider than tip (e.g., Didelphis).';

	TEXT   TAXON = 20 CHARACTER = 42 TEXT = 'character 46 in Wible et al. 2005 Bulletin Carnegie Museum scored as "A" for Erethizon, i.e., polymorphic for 0 "angular process origin in plane of body" and 1 "angular process origin lateral to body"';
	TEXT   TAXON = 96 CHARACTER = 42 TEXT = 'character 46 in Wible et al. 2005 Bulletin Carnegie Museum scored as "0", "angular process origin in plane of body"';
	TEXT   TAXON = 98 CHARACTER = 42 TEXT = 'character 46 in Wible et al. 2005 Bulletin Carnegie Museum scored as "0", "angular process origin in plane of body"';

	TEXT   CHARACTER = 45 TEXT = 'from Meng et al. 2003:126 "In geomyoid rodents, the lower incisor extends posteriorly beyond m3; its end projects lateral to the plane of the mandible and creates a capsule on the lateral surface of the coronoid process. In some rodents, such as Tsaganomys and Pedetes, the long lower incisor extends posteriorly even to the mandibular condyle, but it does not project laterally as a capsule. Presence of the capsule^nmay increase the area for the attachment of the masseter muscle.';

	TEXT   TAXON = 33 CHARACTER = 48 TEXT = 'Following Wible 2007:231, Ochotona is recoded to below toothrow: "The additional leporids examined here (Fig. 7B) have the mandibular foramen inferior to the level of the occlusal surface of the toothrow, as do Ochotona (Fig. 7A), Prolagus (Dawson 1968, fig. 7), and Lepus capensis, contra Asher et al. [2005]"';
	TEXT   TAXON = 42 CHARACTER = 48 TEXT = 'Following Wible 2007:231, Ochotona is recoded to below toothrow: "The additional leporids examined here (Fig. 7B) have the mandibular foramen inferior to the level of the occlusal surface of the toothrow, as do Ochotona (Fig. 7A), Prolagus (Dawson 1968, fig. 7), and Lepus capensis, contra Asher et al. [2005]"';
	TEXT   TAXON = 92 CHARACTER = 48 TEXT = 'Following Wible 2007:231, Prolagus is recoded to below toothrow: "The additional leporids examined here (Fig. 7B) have the mandibular foramen inferior to the level of the occlusal surface of the toothrow, as do Ochotona (Fig. 7A), Prolagus (Dawson 1968, fig. 7), and Lepus capensis, contra Asher et al. [2005]"';

	TEXT   CHARACTER = 49 TEXT = 'Enamel distribution on anterior upper dentition---(0) surrounds tooth (e.g., Macropus), (1) discontinuous posteriorly (e.g., Cavia).';

	TEXT   CHARACTER = 61 TEXT = 'from Meng & Wyss 2001: char 25 "second upper premolar"-?(0) blade-like, (1) conical, or (2) hypsodont with enamel fold. When present, P2 is primitively a blade-like tooth with two anteroposteriorly-oriented roots. In Mimotona and Mimolagus P2 is reduced in size and has only one root. In plesiadapiforms the P2 crown is simple but the tooth retains two roots at least in some species (Gingerich, 1976; pers. obs.). This tooth is hypsodont in lagomorphs, the enamel forming a simple internal fold."^nfrom Meng et al. 2003: char 31, "Differing from Meng and Wyss (2001), we scored an additional derived condition, P2 triangular for Hyopsodus, Phenacodus, and Anagale."';

	TEXT   CHARACTER = 66 TEXT = 'Many spp. (e.g., caviids, ctenodactylids, lagomorphs) with crests rather than cusps were coded by Asher et al. 2005 as inapplicable for "P4 buccal cusps", based on overlap with character M44: "taxa that have for character M44-state 2 "strong ridges with cusp lost" always have "crested" buccal cusps for P4; hence we eliminate the "crested" state and code taxa with state M44-2 as inapplicable for this character." However, given that M44 anterior & posterior crests on P4 could not be consistently coded & has been deleted in this study, formerly inapplicable taxa for M42 (P4 buccal cusps) have been coded "present" if they have metacone/paracone cusps or crests (but the character P4 buccal cusps still inapplicable for those taxa without a P4).';
	TEXT   TAXON = 39 CHARACTER = 66 TEXT = 'Myoxus has "P4 buccal cusps" (i.e., paracone & metacone) which rapidly wear into crests (Asher et al. 2005 coded crestiform P4s including Myoxus glis as inapplicable).';
	TEXT   TAXON = 46 CHARACTER = 66 TEXT = 'Many spp. (e.g., caviids, ctenodactylids, lagomorphs) with crests rather than cusps were coded by Asher et al. 2005 as inapplicable for "P4 buccal cusps", based on overlap with character M44: "taxa that have for character M44-state 2 "strong ridges with cusp lost" always have "crested" buccal cusps for P4; hence we eliminate the "crested" state and code taxa with state M44-2 as inapplicable for this character." However, given that M44 anterior & posterior crests on P4 could not be consistently coded & has been deleted in this study, formerly inapplicable taxa for M42 (P4 buccal cusps) have been coded "present" if they have metacone/paracone cusps or crests.';
	TEXT   TAXON = 76 CHARACTER = 66 TEXT = 'see Jaeger 1989: fig. 1-Ib (Geobios, memoire special 12:235-244)';
	TEXT   TAXON = 86 CHARACTER = 66 TEXT = 'See Emry et al. 1986: fig. 2A, J Vert Paleo 6(3):271-280';
	TEXT   TAXON = 92 CHARACTER = 66 TEXT = 'see Angelone 2007:fig. 7b (Geobios 40 (2007) 407–421)';
	TEXT   TAXON = 100 CHARACTER = 66 TEXT = 'see Bryant & McKenna 1995: fig. 10';

	TEXT   CHARACTER = 67 TEXT = 'Note that some glirids (Myoxus glis but not Eliomys) have upper molar styles as traditionally defined, i.e., buccal cusps near or buccal to para- and metacones. However upper molar "styles" as used by Wood & Wilson (and Korth) refer to *lingual* cusps, not buccal. Wahlert 1983 also used "styles" to refer to *lingual* cusps in upper molars of Florentiamys and Gregorymys (Meng et al. 2003 and Asher et al. 2005 followed suit). Here, we reserve the term "style" for its more widely used meaning, i.e., cusps on the buccal margin of a tooth (buccal to para- and metacones) and therefore change the name of this character to reflect what Wahlert 1983 meant for Gregorymys & Florentiamys: "P4 lingual cusps" rather than "styles on P4" as in Asher et al. 2005: 67.';
	TEXT   TAXON = 73 CHARACTER = 67 TEXT = 'note "styles" as used by Wood & Wilson (and Korth) refer to *lingual* cusps, not buccal';

	TEXT   CHARACTER = 68 TEXT = 'Meng et al. 2003 and Asher et al. 2005 may have confused P3 with P4 in sengis. Rhynchocyon and Petrodromus have just two upper molars, so the "AP extended" (state 3) hypocone is characteristic of P3, not P4. P4 hypocone is "present" but not "AP extended" in sengis, so state 3 has been deleted.';
	TEXT   TAXON = 50 CHARACTER = 68 TEXT = 'small but present hypocone on P4 illustrated by Thorington et al. 2005:fig. 3C (JVP 25(4):950-961)';
	TEXT   TAXON = 51 CHARACTER = 68 TEXT = 'Meng et al. 2003 and Asher et al. 2005 may have confused P3 with P4 in sengis. Rhynchocyon and Petrodromus have just two upper molars, so the "AP extended" (state 3) hypocone is characteristic of P3, not P4. P4 hypocone is "present" but not "AP extended" in sengis, so state 3 has been deleted.';
	TEXT   TAXON = 59 CHARACTER = 68 TEXT = 'Tupaia doesn''t have much of a P4 hypocone but is scored as "present" in Asher et al. 2005; this has been changed to polymorphic (0, 1).';

	TEXT   CHARACTER = 74 TEXT = 'Meng et al. 2003: 121, "the protoloph, the ridge connecting the protocone and paracone"';
	TEXT   TAXON = 35 CHARACTER = 74 TEXT = 'incorrectly coded as "abs" by Asher et al. 2005; here changed to "present"';
	TEXT   TAXON = 37 CHARACTER = 74 TEXT = 'Wear likely makes the proto-paracone connection in murids appear like a protoloph, but this character is coded here "absent" in Mus & Rattus following Meng et al. 2003, presumably based on unword specimens with conical para- & protocones that lack a protoloph';
	TEXT   TAXON = 49 CHARACTER = 74 TEXT = 'Wear likely makes the proto-paracone connection in murids appear like a protoloph, but this character is coded here "absent" in Mus & Rattus following Meng et al. 2003, presumably based on unword specimens with conical para- & protocones that lack a protoloph.';

	TEXT   CHARACTER = 76 TEXT = 'from Meng & Wyss 2001: char 45, "The metacone and paracone are usually conical and connected by an anteroposteriorly-oriented crest (the centrocrista) in non-gliroid eutherians."^n(M59, MW45) upper molar centrocrista---(0) present (e.g., Petrodromus), ^n(1) absent (e.g., Cavia).';

	TEXT   TAXON = 35 CHARACTER = 78 TEXT = 'sciurids show AP elongate protocone that with wear shows an even greater U-Shape, reminiscent of the protocone of Anagale. Marmota & Sciurus were previously coded by Meng et al. 2003 and Asher et al. 2005 as "0 conical" but are more accurately "U-shaped".';
	TEXT   TAXON = 52 CHARACTER = 78 TEXT = 'sciurids show AP elongate protocone that with wear shows an even greater U-Shape, reminiscent of the protocone of Anagale. Marmota & Sciurus were previously coded by Meng et al. 2003 and Asher et al. 2005 as "0 conical" but are more accurately "U-shaped".';

	TEXT   TAXON = 35 CHARACTER = 79 TEXT = 'Un/less-worn specimens of Marmota (UMZC E1762) show metaconules, and a slightly weaker protoconule on M3.';

	TEXT   TAXON = 73 CHARACTER = 81 TEXT = 'note "styles" as dental terms used by Wood & Wilson (but not Marivaux) refer to *lingual* cusps, not buccal.';

	TEXT   CHARACTER = 83 TEXT = '(M65) upper molar cusps lingual to protocone---(0) absent (e.g., Didelphis), (1) present (e.g., Mus).';

	TEXT   CHARACTER = 84 TEXT = 'from Meng et al. 2003: char 67, "Mesoloph (mesolophule) (0) absent, or (1) present. The mesoloph is a crest from the mesocone toward the buccal or lingual margins of the tooth (Wood and Wilson, 1936)..."';
	TEXT   TAXON = 50 CHARACTER = 84 TEXT = 'crest extending buccal from protocone but not connecting to mesostyle, arguably equivalent to "protolophule II" of Marivaux et al. 2004';

	TEXT   CHARACTER = 89 TEXT = 'from Asher et al. 2005:suppdata, ''(M109, POM of Wahlert, 1974) posterior maxillary notch---(0) open (e.g., Cavia), (1) notched (e.g., Petrodromus), (2) forms closed foramen (e.g., Marmota).';

	TEXT   TAXON = 16 CHARACTER = 90 TEXT = corrected_from_Asher_et_al._2005;

	TEXT   CHARACTER = 91 TEXT = 'from Asher et al. 2005:suppdata char 94, "(M131, MW64) hard palate length---(0) long (e.g., Didelphis), (1) short (e.g., Lepus). In order to be consistent with Meng et al. (2003), we define the hard palate as "long" when its posterior margin extends posterior to M2, but acknowledge that Asher et al. 2003 treated this character differently, with the cutoff between "long" and "short" at M3. Cavia, Erethizon, and Cynocephalus show the hard palate ending at or anterior to M2, and are therefore coded as "short" (state 1)."';

	TEXT   CHARACTER = 92 TEXT = 'from Asher et al. 2005: suppdata, char 95, "infraorbital canal length---(0) short, i.e., smaller in length than anteroposterior length of upper M1 (e.g., Cavia), (1) longer than anteroposterior length of upper M1 (e.g., Didelphis), (2) anteriorly extended such that the anterior foramen approaches the suture with the premaxilla (e.g., Florentiamys)."';

	TEXT   CHARACTER = 93 TEXT = comparisons_refer_to_anterior_opening_diameter;
	TEXT   TAXON = 67 CHARACTER = 93 TEXT = 'following Carrasco & Wahlert 1999: fig. 1 and text on top left p. 12, Cricetops shows a "hystricomorphous" infraorbital foramen';
	TEXT   TAXON = 70 CHARACTER = 93 TEXT = 'see Wahlert 1983:fig. 5';
	TEXT   TAXON = 72 CHARACTER = 93 TEXT = 'see Wahlert & Souza 1988:fig. 1';
	TEXT   TAXON = 87 CHARACTER = 93 TEXT = 'see Wahlert 1978:fig. 1';
	TEXT   TAXON = 100 CHARACTER = 93 TEXT = 'see Fig. 5 in Bryant & McKenna 1995. Also their p. 9 "The infraorbital foramen is small, ovate, and inclined slightly in anterior view, with no evidence for passage of the masseter onto the rostrum (fig. 5)."';

	TEXT   TAXON = 16 CHARACTER = 99 TEXT = 'nasolacrimal canal runs medial to root of dI2, as reported in Frahnert 1999 and visible in UMZC E3002 (contra Asher et al. 2005)';
	TEXT   TAXON = 18 CHARACTER = 99 TEXT = 'nasolacrimal canal runs medial to root of dI2, as reported in Landry 1999:plate 2A (contra Asher et al. 2005)';
	TEXT   TAXON = 33 CHARACTER = 99 TEXT = 'Lepus nasolacrimal canal is far posterior to the upper incisor roots, so should be "unrelated incisor" following coding in Meng et al. 2003 (and as pointed out by Wible 2007:226)';

	TEXT   TAXON = 37 CHARACTER = 100 TEXT = 'both Rattus & Mus have a "lateral wall of the nasolacrimal duct" that is "partially lost ... which creates a large opening on the medial wall of the infraorbital canal" (Meng et al. 2003:p. 129). This was coded as "abs" in Meng et al. 2003 and Asher et al. 2005 but should be "present".';
	TEXT   TAXON = 49 CHARACTER = 100 TEXT = 'both Rattus & Mus have a "lateral wall of the nasolacrimal duct" that is "partially lost ... which creates a large opening on the medial wall of the infraorbital canal" (Meng et al. 2003:p. 129). This was coded as "abs" in Meng et al. 2003 and Asher et al. 2005 but should be "present".';
	TEXT   TAXON = 79 CHARACTER = 100 TEXT = 'see Archibald et al. 2001:fig. 1';

	TEXT   TAXON = 92 CHARACTER = 101 TEXT = 'corrected to "?" based on Wible 2007:226';

	TEXT   TAXON = 43 CHARACTER = 102 TEXT = 'see https://animaldiversity.org/accounts/Orthogeomys_heterodus/specimens/collections/contributors/skulls/orthogeomys/o._heterodus/91056.dorsal/';
	TEXT   TAXON = 92 CHARACTER = 102 TEXT = 'corrected to "?" based on Wible 2007:226';

	TEXT   TAXON = 43 CHARACTER = 103 TEXT = 'see https://animaldiversity.org/accounts/Orthogeomys_heterodus/specimens/collections/contributors/skulls/orthogeomys/o._heterodus/91056.dorsal/';
	TEXT   TAXON = 82 CHARACTER = 103 TEXT = 'corrected to "?" based on Wible 2007:226';
	TEXT   TAXON = 92 CHARACTER = 103 TEXT = 'corrected to "?" based on Wible 2007:226';

	TEXT   CHARACTER = 107 TEXT = 'Meng et al. 2003:134, "Anterior projection of frontal between premaxilla and maxilla"';
	TEXT   TAXON = 1 CHARACTER = 107 TEXT = 'note error in Asher et al. 2005 suppdata p. 31 referring to Didelphis as "absent" when in fact it is inapplicable';
	TEXT   TAXON = 16 CHARACTER = 107 TEXT = 'note coded by Asher et al. 2005 as "present" in Dipodomys, but UMZC E3002 lacks narrow extension of frontal poking forward between pmax & nasal. Changed to polymorphic';

	TEXT   TAXON = 42 CHARACTER = 108 TEXT = 'Asher et al. 2005 ("1 parallel") corrected to state 2 narrow anterior & broad posterior based on Wible 2007:224';
	TEXT   TAXON = 82 CHARACTER = 108 TEXT = 'State 3 "broad & round" for Mimolagus is from Meng et al. 2003 and is consistent with Wible 2007:224, "the nasals broadens posteriorly in Mimolagus"';

	TEXT   CHARACTER = 109 TEXT = 'Meng & Wyss 2001, Meng et al. 2003 coded this as to represent the widely open maxillary wall of the lateral rostrum, often with a lattice-like structure (obvious in leporids, less dense in Ochotona). In taxa with a lateral vacuity to their nasolacrimal canal (e.g., Neotoma, Cricetomys, Dipodomys, etc.), the exposed turbinates & intra-nasal structures have a lattice-like appearance, but these do not comprise the maxillary wall of the lateral rostrum. We code this to preserve meaning of Meng & Wyss 2001, "present" when the lateral maxilla on the rostrum is widely fenestrated with some evidence of a lattice-like structure. We code it as absent when the maxilla is intact and/or shows no lattice-like structure, even in taxa with a lateral vacuity in their nasolacrimal canal (and thereby change coding to "absent" in Dipodomys, Myoxus, Massoutiera relative to Asher et al. 2005).';

	TEXT   CHARACTER = 110 TEXT = '(M122, MW67) antorbital fossa---(0) flat (e.g., Cavia), (1) distinctive (e.g., Didelphis). Taxa with a "zygomatic plate," i.e., with masseter inserting broadly onto the lateral rostrum anterior to the orbit, show a "pseudo"-antorbital fossa (cf. Sciurus). However, this differs from the true antorbital fossa of Petrodromus in that the latter is continuous with the lateral face of the zygomatic arch; whereas in Sciurus the lateral face of the zygomatic arch is separate from the "pseudo"-antorbital fossa caused by the zygomatic plate.';

	TEXT   CHARACTER = 111 TEXT = '(ordered; M126) zygomatic plate---(0) absent (e.g., Didelphis), (1) fossa extends to infraorbital foramen (e.g., Mus), (2) fossa extends anterior to infraorbital foramen (e.g., Marmota), (3) fossa extends to incisors (e.g., Florentiamys). These recoded states reflect the increasing size of the zygomatic plate from Didelphis (state 0), to Mus (state 1), to Sciurus (state 2), to Florentiamys (state 3), and comprise a potentially ordered morphocline.';
	TEXT   TAXON = 77 CHARACTER = 111 TEXT = zygomatic_plate_much_more_developed_in_USNM_617532_than_in_USNM_16828;

	TEXT   CHARACTER = 112 TEXT = '(ordered; M123, MW58) anterior root of zygomatic arch---(0) posterior to M2 (e.g., Didelphis), (1) adjacent to M1-M2 (e.g., Lepus), (2) anterior to M1 (e.g., Cavia).';

	TEXT   CHARACTER = 113 TEXT = '(ordered; M124, MW59) ventral projection of maxilla on zygomatic arch---(0) absent (e.g., Didelphis), (1) present (e.g., Hydrochoerus), (2) present and double (e.g., Rhombomylus).';

	TEXT   CHARACTER = 114 TEXT = '(M143) ventral projection of jugal on zygomatic arch---(0) absent (e.g., Didelphis), (1) present (e.g., Rhombomylus).';

	TEXT   CHARACTER = 115 TEXT = '(M142) dorsal process of jugal---(0) weak-absent (e.g., Didelphis), (1) strong (e.g., Notharctus).';

	TEXT   CHARACTER = 116 TEXT = '(ordered; M125, MW60) zygomatic fossa---(0) absent (e.g., Didelphis), (1) present (e.g., Lepus), (2) broad (e.g., Rhombomylus).';

	TEXT   CHARACTER = 120 TEXT = 'from Meng & Wyss 2001:44 (their character 73): ''Left and right optic foramina (0) separate, or (1) confluent anteriorly along the skull midline. This character has been scored differently by various authors (e.g., Li and Ting, 1985; Novacek, 1985, 1986b). We regard only the condition seen in lagomorphs as being confluent, the anterior borders of the two foramina being indivisible. This contrasts with the condition in other mammals where, even if the foramina are large and occur near the midline, the anterior edges of the left and right foramina remain distinct.''';
	TEXT   TAXON = 95 CHARACTER = 120 TEXT = 'Wible 2007:226 notes "Meng et al. (2003, p. 60) described the foramina as confluent in Rhombomylus, but scored them as separate in their matrix". Like Wible we recode optic foramina as confluent here.';

	TEXT   CHARACTER = 121 TEXT = '(M127, MW74) position of anterior margin of orbit---(0) above M1 or posterior (e.g., Didelphis), (1) above P4 or anterior (e.g., Rattus).';
	TEXT   TAXON = 48 CHARACTER = 121 TEXT = 'although P4 is absent, anterior margin of orbit is sufficiently farther anterior to M1 to qualify for state 1';

	TEXT   TAXON = 1 CHARACTER = 123 TEXT = 'contra Asher et al. 2005, some specimens of Didelphis (TMM-M2517) do show exposed roots on dorsum of maxilla forming floor of orbit. Coded here as polymorphic';
	TEXT   TAXON = 33 CHARACTER = 123 TEXT = 'Wible 2007:226 notes that root exposure on orbital floor is "clearly present in Mimolagus (Bohlin 1951, fig. 10) and is perhaps more variable as there is no exposure in the CM specimens of Oryctolagus, Lepus, Pronolagus, and Romerolagus (Figs. 2B, 3B), but is in Brachylagus and Sylvilagus. Also, Wood (1940) reported this as variable in Palaeolagus."';
	TEXT   TAXON = 44 CHARACTER = 123 TEXT = 'Wible 2007:226 notes that root exposure on orbital floor is "clearly present in Mimolagus (Bohlin 1951, fig. 10) and is perhaps more variable as there is no exposure in the CM specimens of Oryctolagus, Lepus, Pronolagus, and Romerolagus (Figs. 2B, 3B), but is in Brachylagus and Sylvilagus. Also, Wood (1940) reported this as variable in Palaeolagus."';
	TEXT   TAXON = 82 CHARACTER = 123 TEXT = 'Wible 2007:226 notes that root exposure on orbital floor is "clearly present in Mimolagus (Bohlin 1951, fig. 10) and is perhaps more variable as there is no exposure in the CM specimens of Oryctolagus, Lepus, Pronolagus, and Romerolagus (Figs. 2B, 3B), but is in Brachylagus and Sylvilagus. Also, Wood (1940) reported this as variable in Palaeolagus."';
	TEXT   TAXON = 86 CHARACTER = 123 TEXT = 'Wible 2007:226 notes that root exposure on orbital floor is "clearly present in Mimolagus (Bohlin 1951, fig. 10) and is perhaps more variable as there is no exposure in the CM specimens of Oryctolagus, Lepus, Pronolagus, and Romerolagus (Figs. 2B, 3B), but is in Brachylagus and Sylvilagus. Also, Wood (1940) reported this as variable in Palaeolagus."';

	TEXT   TAXON = 33 CHARACTER = 127 TEXT = 'Corrected to "present" in Lepus based on Wible 2007:224';

	TEXT   TAXON = 73 CHARACTER = 128 TEXT = 'based on Galbreath 1948: plate 3';

	TEXT   TAXON = 16 CHARACTER = 130 TEXT = 'Dipodomys is similar to Heteromys; sphenopalatine foramen is largely in maxilla, but with frontal not just close to dorsal border (as in Heteromys) but comrprising dorsal margin of sphenopalatine foramen. Orbitosphenoid is too far posterior to contribute to margins of sphenopalatine foramen.';
	TEXT   TAXON = 27 CHARACTER = 130 TEXT = 'largely in maxilla;  frontal comes close to posteromedial wall. Optic foramina & orbitosphenoid are too far posterior to contribute to sphenopalatine foramen.';
	TEXT   TAXON = 33 CHARACTER = 130 TEXT = 'Following Wible 2007:226, Prolagus, Ochotona, and leporids show sphenopalatine foramen between palatine and maxilla.';
	TEXT   TAXON = 42 CHARACTER = 130 TEXT = 'Following Wible 2007:226, Prolagus, Ochotona, and leporids show sphenopalatine foramen between palatine and maxilla.';
	TEXT   TAXON = 44 CHARACTER = 130 TEXT = 'Following Wible 2007:226, Prolagus, Ochotona, and leporids show sphenopalatine foramen between palatine and maxilla.';
	TEXT   TAXON = 47 CHARACTER = 130 TEXT = sphenoid_abuts_on_dorsal_margin_of_sphenopalatine_foramen;
	TEXT   TAXON = 50 CHARACTER = 130 TEXT = 'part of dorsal border formed by frontal; otherwise sphenopalatine foramen in Ratufa UMZC E1570 is in maxilla';
	TEXT   TAXON = 54 CHARACTER = 130 TEXT = 'Following Wible 2007:226, Prolagus, Ochotona, and leporids show sphenopalatine foramen between palatine and maxilla.';
	TEXT   TAXON = 73 CHARACTER = 130 TEXT = 'based on Galbreath 1948: plate 3';
	TEXT   TAXON = 77 CHARACTER = 130 TEXT = 'wahlert 1974:390 writes "fused maxilla and palatine surround it almost entirely... only a small arm of orbitosphenoid reaches it posteriorly"';

	TEXT   CHARACTER = 131 TEXT = 'from Meng et al. 2003: ''Character 112: Sphenopalatine vacuity-(0) absent, or (1) present. This foramen exists in the roof of the choana, between the palatine and pterygoid. Cooper and Schiller (1975: "figs. 2-4, 2-5) referred to the opening in Cavia as the "sphenopalatine foramen", which is different from the usage of the term in this and other studies (e.g., Wahlert, 1974; Novacek, 1986b). This opening is named the sphenopalatine vacuity (Wahlert et al., 1993; Voss, 1988), which we follow here.''';
	TEXT   TAXON = 43 CHARACTER = 131 TEXT = 'No gap between pterygoid and palatine along midline apparent in area around internal nares/choana.';

	TEXT   TAXON = 73 CHARACTER = 132 TEXT = 'jugal itself is missing, but scars on squamosal & maxillary zygomatic arch indicate a gracile, small bone that would not have extended posterior to glenoid fossa for dentary condyle';

	TEXT   CHARACTER = 134 TEXT = 'from Meng et al. 2003:134 (M149), ''Glenoid fossa"-"""""?(0) near the auditory region, or (1) anterodorsal. In most eutherians the glenoid fossa is lateral to the middle-ear region. In Glires the glenoid fossa, and therefore the jaw articulation and the posterior root of the zygomatic arch, has moved a considerable distance anterodorsally (Van Kampen, 1905; Landry, 1999).'' State 1 "anterodorsal" means that the dorsal-most point of the glenoid fossa for the dentary is situated dorsal to the oval window of the pars cochlearis by at least one length of the manubrium of the malleus.';

	TEXT   TAXON = 42 CHARACTER = 138 TEXT = 'Following Wible 2007: 229 "I found the condition in Ochotona to be variable. In the illustrated Ochotona, the foramen is entirely within the^nalisphenoid (Fig. 4A), whereas in others (e.g., CM 65091) it is between the alisphenoid and petrosal."';

	TEXT   TAXON = 71 CHARACTER = 139 TEXT = 'Note following Wible 2007:229 (Bulletin Carnegie Museum), the "sphenopterygoid canal" duplicates the alisphenoid canal character and therefore "sphenopterygoid canal" has been deleted. The structure in Gomphos labeled "sc" in Asher et al. 2005:fig. 2C is equivalent to the alisphenoid canal.';
	TEXT   TAXON = 86 CHARACTER = 139 TEXT = 'following Wible 2007:229 "The condition in Palaeolagus is uncertain."';
	TEXT   TAXON = 95 CHARACTER = 139 TEXT = 'Wible 2007:229 notes "Meng et al. (2003, fig. 36) tentatively identified an alisphenoid canal in Rhombomylus, but it is through the ectopterygoid crest and not the anterior wall of the pterygoid fossa, which is devoid of openings (Meng et al. 2003, fig. 33A). The condition in Palaeolagus is uncertain."';

	TEXT   TAXON = 73 CHARACTER = 140 TEXT = ridge_present_but_this_is_on_basiocciptal;

	TEXT   TAXON = 43 CHARACTER = 141 TEXT = shows_large_fissure_between_mastoid_&_supraoccipital;
	TEXT   TAXON = 46 CHARACTER = 141 TEXT = 'Pedetes shows mastoid-like foramina at dorsal margin of mastoids on roof of skull, at medial end of long gap between parietal and mastoid';
	TEXT   TAXON = 77 CHARACTER = 141 TEXT = 'see Wahlert 1974:fig. 9';

	TEXT   CHARACTER = 143 TEXT = 'Mistakenly called "ento"pterygoid crest by Asher et al. 2005; should be ECTOpterygoid crest as hamulus is the ventral tip of entopterygoid crest, and ectopterygoid crest is either anterior (e.g., Leptictis) or posterior (e.g., Zalambdalestes) to it, as coded by Asher et al. 2005. Add state for "ectopterygoid crest absent".';
	TEXT   TAXON = 18 CHARACTER = 143 TEXT = 'Following CT scan of echimyine (Duke EA-201) and Fig. 3 in Iack-Ximenes et al. 2005, the ectopterygoid crest in Echimys is sufficiently reduced so that the pterygoid fossa is essentially absent.';
	TEXT   TAXON = 27 CHARACTER = 143 TEXT = 'scored based on H. desmarestianus (https://animaldiversity.org/accounts/Heteromys_desmarestianus/specimens/collections/contributors/skulls/heteromys/h._goldmani/heteromys_ventral/). UM305 Heteromys CT scan has broken hamuli & entopterygoid crests';
	TEXT   TAXON = 32 CHARACTER = 143 TEXT = 'based on CT of Herrel MNHN "rat2" specimen';
	TEXT   TAXON = 34 CHARACTER = 143 TEXT = 'evident in roll movie of http://digimorph.org/specimens/Macropus_rufus/skull/';
	TEXT   TAXON = 44 CHARACTER = 143 TEXT = 'Wible 2007:229 writes "Rhombomylus (Meng et al. 2003, figs. 24, 33) and Prolagus (Dawson 1968, fig. 4) have the reverse condition with the ectopterygoid crest extending farther posteriorly [than the entopterygoid crest]. Gomphos (Asher et al. 2005, fig. 2C) and Palaeolagus (Dice 1933, plate 26, fig. 1) appear to have the same condition as Rhombomylus and Prolagus. Oryctolagus changed to polymorphic, 0 &1.';
	TEXT   TAXON = 54 CHARACTER = 143 TEXT = 'Wible 2007:229 writes "Rhombomylus (Meng et al. 2003, figs. 24, 33) and Prolagus (Dawson 1968, fig. 4) have the reverse condition with the ectopterygoid crest extending farther posteriorly [than the entopterygoid crest]. Gomphos (Asher et al. 2005, fig. 2C) and Palaeolagus (Dice 1933, plate 26, fig. 1) appear to have the same condition as Rhombomylus and Prolagus. Sylvilagus changed to polymorphic, 0-1.';
	TEXT   TAXON = 58 CHARACTER = 143 TEXT = 'coded as "0" ectopterygoid anterior to hamulus in Asher et al. 2005.';
	TEXT   TAXON = 67 CHARACTER = 143 TEXT = coded_based_on_Carrasco_&_Wahlert_1999_fig._2;
	TEXT   TAXON = 72 CHARACTER = 143 TEXT = 'consistent with Wahlert & Souza 1988: fig. 1';
	TEXT   TAXON = 86 CHARACTER = 143 TEXT = 'Wible 2007:229 writes "Rhombomylus (Meng et al. 2003, figs. 24, 33) and Prolagus (Dawson 1968, fig. 4) have the reverse condition with the ectopterygoid crest extending farther posteriorly [than the entopterygoid crest]. Gomphos (Asher et al. 2005, fig. 2C) and Palaeolagus (Dice 1933, plate 26, fig. 1) appear to have the same condition as Rhombomylus and Prolagus. Palaeolagus changed from ? to 1 post-hamulus.';
	TEXT   TAXON = 92 CHARACTER = 143 TEXT = 'Wible 2007:229 writes "Rhombomylus (Meng et al. 2003, figs. 24, 33) and Prolagus (Dawson 1968, fig. 4) have the reverse condition with the ectopterygoid crest extending farther posteriorly [than the entopterygoid crest]. Gomphos (Asher et al. 2005, fig. 2C) and Palaeolagus (Dice 1933, plate 26, fig. 1) appear to have the same condition as Rhombomylus and Prolagus. Prolagus changed from state 0 to 1 post-hamulus.';
	TEXT   TAXON = 100 CHARACTER = 143 TEXT = 'presence & position of ectopterygoid crest not clear from Bryant & McKenna 1995:fig 4, and insufficiently preserved in UMZC E1880. Changed from Asher et al. 2005 from "0 ant hamulus" to "?"';
	TEXT   TAXON = 102 CHARACTER = 143 TEXT = 'Wible et al. 2004:34 "... The [entopterygoid] crest’s posteroventral tip is the hamulus, which is pointed in PSS-MAE 108 (figs. 33, 34A) and more hooklike in 130, although possibly damaged (figs. 35, 36)."';

	TEXT   TAXON = 32 CHARACTER = 144 TEXT = 'fig. 2 in Cox et al. 2013 (https://www.ncbi.nlm.nih.gov/pubmed/24058888) shows entopterygoid crest-bulla contact: https://dfzljdn9uc3pi.cloudfront.net/2013/160/1/fig-2-2x.jpg';
	TEXT   TAXON = 77 CHARACTER = 144 TEXT = 'base of entopterygoid crest reaches close to bulla in 16828; hamuli themselves are broken but appear to meet bulla in Wahlert 1974: fig. 9';

	TEXT   TAXON = 4 CHARACTER = 145 TEXT = 'piriform fenestra is present in UMZC E1861 and UMMZ specimen (https://animaldiversity.org/accounts/Aplodontia_rufa/specimens/collections/contributors/skulls/aplodontia/a._rufa/164949.ventral/) but mistakenly coded as "absent" in Asher et al. 2005.';
	TEXT   TAXON = 92 CHARACTER = 145 TEXT = 'Wible 2007:229-230 notes "Asher et al. (2005, character 149) scored the piriform fenestra absent in Prolagus, Palaeolagus, Gomphos, and Rhombomylus, and unknown in Mimotona and Mimolagus. Of these, Prolagus clearly has an open space between the alisphenoid and bulla described and illustrated by Dawson (1968: 167, fig. 4); Palaeolagus (Dice 1933, plate 26, fig. 1), Gomphos (Asher et al. 2005, fig. 2C), and Rhombomylus (Meng et al. 2003) lack a piriform fenestra anterior to the bulla."';
	TEXT   TAXON = 100 CHARACTER = 145 TEXT = 'changed from Asher et al. 2005 to state 1 "present" based on fig. 6 in Bryant & McKenna 1995';

	TEXT   TAXON = 100 CHARACTER = 146 TEXT = fig._6_in_Bryant_&_McKenna_1995;

	TEXT   TAXON = 4 CHARACTER = 153 TEXT = 'Presence of meatocochlear bridge is consistent with observation in Emry & Thorington 1982:6 that "periotic and and tympanic bulla fused into a single unit" in sciurids. Hence, present of MCB should result in at least state "1" (part petrosal bulla) for character "petrosal contribution to bulla" (contra Meng et al. 2003 and Asher et al. 2005).';
	TEXT   TAXON = 35 CHARACTER = 153 TEXT = 'Presence of meatocochlear bridge is consistent with observation in Emry & Thorington 1982:6 that "periotic and and tympanic bulla fused into a single unit" in sciurids. Hence, present of MCB should result in at least state "1" (part petrosal bulla) for character "petrosal contribution to bulla" (contra Meng et al. 2003 and Asher et al. 2005).';
	TEXT   TAXON = 52 CHARACTER = 153 TEXT = 'Presence of meatocochlear bridge is consistent with observation in Emry & Thorington 1982:6 that "periotic and and tympanic bulla fused into a single unit" in sciurids. Hence, present of MCB should result in at least state "1" (part petrosal bulla) for character "petrosal contribution to bulla" (contra Meng et al. 2003 and Asher et al. 2005).';
	TEXT   TAXON = 94 CHARACTER = 153 TEXT = 'Presence of meatocochlear bridge is consistent with observation in Emry & Thorington 1982:6 that "periotic and and tympanic bulla fused into a single unit" in sciurids. Hence, present of MCB should result in at least state "1" (part petrosal bulla) for character "petrosal contribution to bulla" (contra Meng et al. 2003 and Asher et al. 2005).';

	TEXT   TAXON = 16 CHARACTER = 154 TEXT = 'scored as abs based on UMZC E3002; changed from "?" in Asher et al. 2005';
	TEXT   TAXON = 35 CHARACTER = 154 TEXT = 'scored as abs based on UMZC E1762; changed from "?" in Asher et al. 2005';

	TEXT   TAXON = 16 CHARACTER = 155 TEXT = 'Dipodomys coded as state 3 "canal" in Asher et al. 2005 but following Brylski 1990 J Morph IC enters braincase via large middle lacerate foramen, anteromedial to ectotympanic bulla. So correct state should be "2, sulcus medial promontory".';

	TEXT   TAXON = 27 CHARACTER = 156 TEXT = 'Packer 1987:555 "...in the unspecialized genera Heteromys and Liomys, the artery involutes during development (Webster & Webster, 1975)."  This is supported by lack of any obvious grooves or canals for either stapedial or int carotid in the (highly spongiose) ear region of Heteromys desmarestianus BMNH-uncat CT scan (although there is a conspicuous & elongate posterior-middle lacerate foramen separating bulla from basioccipital).';
	TEXT   TAXON = 77 CHARACTER = 156 TEXT = 'Wahlert 1974:393 writes that based on absence of a stapedial foramen that the stapedial artery is absent in Ischyromys; Bertrand & Silcox (2016:12) cite Wahlert and write further that "in ROMV 1007 and AMNH F:AM 144836, the cast of the stapedial artery is absent but is identifiable in S. carolinensis AMNH 258346 ...". However, the promontory shows a substantial groove in all CT scanned specimens of Ischyromys examined so far. This groove leads to the foramen ovale and is continuous with the internal carotid foramen & canal. In (for example) ROM V1007 the groove leads to a gap in the roof of the epitympanic recess and adjacent foramina, one of which may have been for the stapedial artery. This indicates that Ischyromys likely had a patent stapedial artery; given its size we regard this as more probable than presence of a nerve or vein only.';

	TEXT   TAXON = 16 CHARACTER = 157 TEXT = 'Aplodontia and Dipodomys were previously coded as "?" for exposed/canal facial nerve. UMZC E1861 (Aplodontia) and UMZC E3002 (Dipodomys) show that the facial nerve is in a canal throughout the middle ear, so coded as state 1, canal.';
	TEXT   TAXON = 18 CHARACTER = 157 TEXT = 'Aplodontia (UMZC E1861) and Dipodomys (UMZC E3002) and Echimys (Duke scan EA-201) were previously coded as "?" for exposed/canal facial nerve. All show that the facial nerve is in a canal throughout the middle ear, so coded as state 1, canal.';

	TEXT   TAXON = 16 CHARACTER = 160 TEXT = 'Dipodomys was previously coded as "?" for meato-cochlear bridge. UMZC E3002 shows that petrosal in area of the fen.ovalis (= oval window) does not have a process that connects to the ectotympanic. Note that meato-cochlear bridge is present in some taxa (e.g., Aplodontia) that lack "stapedial" artery (as named in Meng 1990 AMNH Novitates).';

	TEXT   CHARACTER = 165 TEXT = 'from Asher et al. 2005: suppdata: "(0) flat, ventral rim of foramen magnum on same transverse plane as maxillary teeth (e.g., Castor), (1) arched, ventral rim of foramen magnum ventral to maxillary teeth (e.g., Lepus)." Because the dorsal skull contour is continuously variable and difficult to consistently code on this basis alone, we have opted to focus on the level of the ventral rim of the foramen magnum relative to the maxillary dentition. Based on this criterion, we assign Cavia, Dasyprocta, and Sciurus state 1. We also code Ochotona as having a "flat" skull (state 0), not polymorphic as reported in Meng et al. (2003)."';

	TEXT   CHARACTER = 166 TEXT = '(M174) intercentrum and arches of atlas---(0) unfused, with suture apparent within body of axis (e.g., Macropus), (1) fused, without suture (e.g., Cavia).';
	TEXT   TAXON = 24 CHARACTER = 166 TEXT = UMMZ_59202_CT_specimen_juvenile_without_clear_indication_of_which_sutures_will_fuse;
	TEXT   TAXON = 61 CHARACTER = 166 TEXT = 'from Dagosto 1983:53, "Schlosser [1887] has described the only known elements of the axial skeleton of A. parisiensis. According to him, the atlas and the first thoracic vertebra resemble those of primates, especially Lemur."';
	TEXT   TAXON = 68 CHARACTER = 166 TEXT = 'see Emry & Thorington 1982:10';

	TEXT   CHARACTER = 167 TEXT = '(M175) joint axis body---(0) unfused, with suture within body of axis (e.g., Vombatus), (1) fused, without suture (e.g., Cavia).';

	TEXT   TAXON = 61 CHARACTER = 170 TEXT = 'from Dagosto 1983: fig.1 and text, "Although prominent, neither tuberosity extends beyond the level of the head."';

	TEXT   CHARACTER = 172 TEXT = 'from Asher et al. 2005:supp data: (M181) radial fossa---(0) shallow (e.g., Didelphis), (1) medial groove (e.g., Lepus). We differ from Meng et al. (2003) in that we rely only on the presence or absence of a large, medial groove in the proximal radius to code this character. Lepus shows this medial groove, which divides the radial articular surface into sharply delineated trochlear and capitular facets for the distal humerus. Other taxa, including for example Didelphis and Ochotona, possess a shallow proximal radius, although to varying extents the proximal radius may articulate with both the humeral trochlea and capitulum.';
	TEXT   TAXON = 10 CHARACTER = 172 TEXT = 'C.penicillatus UMMZ 14735 shows fusion of a small sesamoid lateral to the proximal radial articular surface that is typically present but unfused in other rodents. However this does not lead to a "deep" radial fossa divided by a medial groove, as in Lepus.';
	TEXT   TAXON = 32 CHARACTER = 172 TEXT = 'based on CT of MNHN Herrel "rat2"';
	TEXT   TAXON = 68 CHARACTER = 172 TEXT = 'see Emry & Thorington 1982:16';

	TEXT   CHARACTER = 173 TEXT = '(M182) supratrochlear foramen, olecranon fossa of Asher et al. (char. 138)---(0) distal humerus solid (e.g., Didelphis), (1) fenestrated in olecranon fossa (e.g., Lepus).';
	TEXT   TAXON = 61 CHARACTER = 173 TEXT = 'based on Dagosto 1983:fig 1';

	TEXT   CHARACTER = 174 TEXT = '(M183) ulnar reduction---(0) continuous between elbow and carpus (e.g., Didelphis), (1) ulna tapers proximal to the carpus (e.g., Cynocephalus). The distal ulna in Cynocephalus and some elephant shrews tapers to a point along the radial shaft and lacks a carpal articulation (Asher et al., 2003: character 144).';
	TEXT   TAXON = 61 CHARACTER = 174 TEXT = 'Godinot 1992: fig. 5';

	TEXT   CHARACTER = 176 TEXT = '(M185, Meng et al. 2003: fig. 58) central process of radial head---(0) small or absent (e.g., Didelphis), (1) present (e.g., Lepus). from Meng et al. 2003:138 (their char 185), ''Character 185: Central process of the radial head"-?(0) poorly developed or absent, or (1) well developed. The central process on the head of the radius is often well developed in terrestrial mammals and poorly developed in arboreal groups (Szalay and Sargis, 2001).';

	TEXT   CHARACTER = 177 TEXT = 'ulnar facet of radial head---(0) convex and ovoid (e.g., Didelphis), ^n(1) flat (e.g., Lepus).';
	TEXT   TAXON = 32 CHARACTER = 177 TEXT = 'based on CT of MNHN Herrel "rat2"';

	TEXT   CHARACTER = 178 TEXT = '(M188) scaphoid and lunate---(0) separate (e.g., Didelphis), (1) fused (e.g., Cavia).';
	TEXT   TAXON = 21 CHARACTER = 178 TEXT = 'see radiograph in Hamrick 1996: fig. 6 (AJPA 99:319-344) showing unfused scaphoid & lunate in Eulemur fulvus';
	TEXT   TAXON = 46 CHARACTER = 178 TEXT = 'see fig. 1 in Parsons 1889 Proc Zool Soc London 858-890';
	TEXT   TAXON = 61 CHARACTER = 178 TEXT = 'Godinot 1992: fig. 5';
	TEXT   TAXON = 68 CHARACTER = 178 TEXT = 'see Emry & Thorington 1982:18';

	TEXT   CHARACTER = 179 TEXT = '(M189) centrale---(0) present (e.g., Lepus), (1) absent (e.g., Didelphis).';
	TEXT   TAXON = 30 CHARACTER = 179 TEXT = Not_present_on_mounted_skeleton_of_UMZC_E3420._Specimen_appears_reasonably_intact_but_has_been_taxidermied_&_prepped.;
	TEXT   TAXON = 32 CHARACTER = 179 TEXT = 'based on CT of MNHN Herrel "rat2"';
	TEXT   TAXON = 46 CHARACTER = 179 TEXT = 'see fig. 1 & p. 862 in Parsons 1898 Proc Zool Soc London 858-890';
	TEXT   TAXON = 61 CHARACTER = 179 TEXT = 'Godinot 1992: fig. 5d';

	TEXT   CHARACTER = 181 TEXT = '(M191) articular surface of femoral head---(0) extended posterolaterally (e.g., Lepus), (1) limited to sphere of femoral head (e.g., Castor).';
	TEXT   TAXON = 61 CHARACTER = 181 TEXT = 'Bacon & Godinot 1988: figs 1, 2^nAlso Dagosto 1983: 67  "The articular facet of the head extends onto the neck of the femur proximally, but it is not as posteriorly extensive as in lorisines."';
	TEXT   TAXON = 68 CHARACTER = 181 TEXT = 'see Emry & Thorington 1982:fig. 12';

	TEXT   TAXON = 45 CHARACTER = 182 TEXT = 'see fig. 15 in Fleagle & Mcraw 2002, J Hum Evol. 42: 267–292';
	TEXT   TAXON = 61 CHARACTER = 182 TEXT = 'Bacon & Godinot 1988: figs 1, 2';
	TEXT   TAXON = 68 CHARACTER = 182 TEXT = 'see Emry & Thorington 1982:fig. 12';
	TEXT   TAXON = 84 CHARACTER = 182 TEXT = changed_from_state_0_as_coded_in_Meng_et_al._2003_and_Asher_et_al._2005;

	TEXT   TAXON = 45 CHARACTER = 183 TEXT = 'see fig. 15 in Fleagle & Mcraw 2002, J Hum Evol. 42: 267–292';
	TEXT   TAXON = 68 CHARACTER = 183 TEXT = 'see Emry & Thorington 1982:fig. 12';
	TEXT   TAXON = 84 CHARACTER = 183 TEXT = changed_from_state_0_as_coded_in_Meng_et_al._2003_and_Asher_et_al._2005;

	TEXT   TAXON = 61 CHARACTER = 184 TEXT = 'Dagosto 1983:fig. 4E';

	TEXT   TAXON = 4 CHARACTER = 185 TEXT = 'Aplodontia shows fused prox tib-fibula in UMZC E1861 (coded "separate" in Asher et al. 2005). Recoded as polymorphic.';
	TEXT   TAXON = 19 CHARACTER = 185 TEXT = 'see Bover et al. 2009: fig. 3B, 3C^nhttps://journals.plos.org/plosone/article?id=10.1371/journal.pone.0015817';
	TEXT   TAXON = 68 CHARACTER = 185 TEXT = 'see Emry & Thorington 1982:fig. 13';
	TEXT   TAXON = 88 CHARACTER = 185 TEXT = based_on_fig._10_of_Rose_&_Chinnery_2004_Bulletin_Carnegie_Museum_#36;

	TEXT   TAXON = 19 CHARACTER = 186 TEXT = 'see Bover et al. 2009: fig. 3B, 3C^nhttps://journals.plos.org/plosone/article?id=10.1371/journal.pone.0015817';

	TEXT   CHARACTER = 187 TEXT = '(M200, Horovitz & Sanchez-Villagra 2003 character #84) articulation between femur and fibula---(0) absent (e.g., Lepus), (1) present (e.g., Didelphis).';
	TEXT   TAXON = 19 CHARACTER = 187 TEXT = 'see Bover et al. 2009: fig. 3B, 3C^nhttps://journals.plos.org/plosone/article?id=10.1371/journal.pone.0015817';

	TEXT   CHARACTER = 188 TEXT = 'from Meng et al. 2003:char 201, "Fibula"-(0) robust relative to the tibia, or (1) slim." We define "slim" as fibula with less than half the midshaft diameter of the corresponding plane of the tibia.';
	TEXT   TAXON = 19 CHARACTER = 188 TEXT = 'see Bover et al. 2009: fig. 3B, 3C^nhttps://journals.plos.org/plosone/article?id=10.1371/journal.pone.0015817';

	TEXT   CHARACTER = 189 TEXT = '(M202) tibial malleolus---(0) prominent (e.g., Didelphis), (1) reduced (e.g., Lepus), (2) with convex articular facet for astragalus (e.g., Petrodromus).';
	TEXT   TAXON = 68 CHARACTER = 189 TEXT = 'Emry & Thorington 1982:24, "the tibia participates slightly more in the lateral surface of the astragalar joint" (see also their fig. 13)';

	TEXT   TAXON = 68 CHARACTER = 190 TEXT = 'see Emry & Thorington 1982: fig. 13';

	TEXT   TAXON = 68 CHARACTER = 191 TEXT = 'Emry & Thorington 1982:fig. 15';

	TEXT   TAXON = 16 CHARACTER = 192 TEXT = 'Dipodomys shows asymmetric astralagar trochlea, with medial ridge lower than lateral, as in (for example) Lepus, but was coded by Asher et al. 2005 as lateral trochlea "equal medial border". Recode as "higher".';
	TEXT   TAXON = 68 CHARACTER = 192 TEXT = 'Emry & Thorington 1982:fig. 15 and text p. 26';

	TEXT   TAXON = 68 CHARACTER = 193 TEXT = 'Emry & Thorington 1982:fig. 15';
	TEXT   TAXON = 77 CHARACTER = 193 TEXT = 'based on Scott et al. 1937: plateXXV-8';

	TEXT   TAXON = 15 CHARACTER = 194 TEXT = 'Hooker 2001 codes "Galeopterus" as having a "more ventral" extent of the astragalar trochlea (char 5 state 1). Meng et al. 2003 code Cynocephalus variegatus (= Galeopterus following Wilson & Reeder 2005) as state "0" (not exceeding midpoint of posterior astrag body). However without a trochlea (which colugos lack) it seems best to code further trochlear characters as inapplicable.';
	TEXT   TAXON = 68 CHARACTER = 194 TEXT = 'Emry & Thorington 1982:fig. 15';

	TEXT   TAXON = 68 CHARACTER = 195 TEXT = 'Emry & Thorington 1982:fig. 15';
	TEXT   TAXON = 77 CHARACTER = 195 TEXT = 'based on Scott et al. 1937: plateXXV-8 and rudiment present in USNM 617532';

	TEXT   TAXON = 68 CHARACTER = 196 TEXT = 'Emry & Thorington 1982:fig. 15';

	TEXT   TAXON = 6 CHARACTER = 197 TEXT = 'the "dorsal" astragalar forman in Arvicola UMZC E2805 is slightly anterior to the trochlea on the proximal part of the astragalar neck, but has a clear continuity with a space inside the astragalus continuous with a large foramen on the ventral aspect of the astragalus, at the ventral apex of the trochlea just medial to the facet for the calcaneus';
	TEXT   TAXON = 61 CHARACTER = 197 TEXT = 'Coded as present in Meng et al. 2003: char 210. However, foramen appears to be lacking in at least some specimens w/ meshes on morphosource, e.g., ISE-M-ROS-2-108, Adapis parisiensis^nhttps://www.morphosource.org/Detail/MediaDetail/Show/media_id/4447';
	TEXT   TAXON = 68 CHARACTER = 197 TEXT = 'Emry & Thorington 1982:fig. 15';

	TEXT   CHARACTER = 198 TEXT = '(M211; H102) astragalar sustentacular facet orientation---(0) restricted to ventral aspect of astragalus (e.g., Didelphis), (1) extends also to medial aspect of astragalus (e.g., Glis).';
	TEXT   TAXON = 68 CHARACTER = 198 TEXT = 'Emry & Thorington 1982:fig. 15';
	TEXT   TAXON = 88 CHARACTER = 198 TEXT = 'Szalay 1985:figs 2, 6 (chapter in Luckett & Hartenberger) shows calcaneus & astrag of Paramys copei, AMNH 2682';

	TEXT   TAXON = 68 CHARACTER = 199 TEXT = 'Emry & Thorington 1982:fig. 15';
	TEXT   TAXON = 88 CHARACTER = 199 TEXT = 'Szalay 1985:figs 2, 6 (chapter in Luckett & Hartenberger) shows calcaneus & astrag of Paramys copei, AMNH 2682';

	TEXT   CHARACTER = 200 TEXT = '(M213) orientation of calcaneoastragalar and sustentacular facet long axes---(0) angled (e.g., Didelphis), (1) parallel (e.g., Lepus).';

	TEXT   CHARACTER = 201 TEXT = '(ordered; M214) astragalar neck length---(0) shorter than astragalar body width (e.g., Didelphis), (1) similar in length as astragalar body width (e.g., Ochotona), (2) longer than astragalar body width (e.g., Sylvilagus).';
	TEXT   TAXON = 68 CHARACTER = 201 TEXT = 'Emry & Thorington 1982:fig. 15';

	TEXT   CHARACTER = 202 TEXT = '(M215) astragalonavicular facet orientation---(0) wider transversely than dorsoventrally (e.g., Didelphis), (1) wider dorsoventrally than transversely (e.g., Lepus).';

	TEXT   TAXON = 68 CHARACTER = 203 TEXT = 'Emry & Thorington 1982:figs. 15, 16';

	TEXT   CHARACTER = 204 TEXT = 'from Asher et al. 2005: suppdata char 209, "...calcaneal canal---(0) absent (e.g., Didelphis), (1) present (e.g., Ochotona). When present this structure courses distomedially through the calcaneus, entering just proximal to the fibular facet and exiting distal to the sustentacular facet in Ochotona."';
	TEXT   TAXON = 32 CHARACTER = 204 TEXT = 'based on CT of MNHN Herrel "rat2"';

	TEXT   CHARACTER = 205 TEXT = '(M217) calcaneal width---(0) broad with sustentacular and ectal facets extending away from body of calcaneus (e.g., Didelphis), (1) narrow with sustentacular and ectal facets in line with calcaneal long axis (e.g., Lepus).';

	TEXT   TAXON = 5 CHARACTER = 206 TEXT = 'Arvicanthis BMNH-ZD-1892.9.9 shows a distally extensive fibula with a deep flexor groove that extends slightly lateral to the calcaneoastragalar facet on the calcaneus. However unlike Lepus there is no actual facet on the calcaneus for the fibula and therefore this character is coded "0" absent';

	TEXT   CHARACTER = 207 TEXT = '(M219) calcaneoastragalar (ectal) facet on calcaneus---(0) diagonal to long axis of calcaneus (e.g., Didelphis), (1) parallel to long axis of calcaneus (e.g., Lepus), (2) facet short with no clear orientation (e.g., Petrodromus).';
	TEXT   TAXON = 68 CHARACTER = 207 TEXT = 'Emry & Thorington 1982:fig. 14';

	TEXT   CHARACTER = 208 TEXT = '(M220) position of calcaneoastragalar (ectal) facet---(0) towards distal end of calcaneal body (e.g., Didelphis), (1) at midpoint of calcaneal body (e.g., Lepus).';
	TEXT   TAXON = 61 CHARACTER = 208 TEXT = 'coded as missing in Meng et al. 2003, but meshes available on morphosource (https://www.morphosource.org/Detail/MediaDetail/Show/media_id/1319) show calcaneoastragalar facet slightly closer to distal end';
	TEXT   TAXON = 68 CHARACTER = 208 TEXT = 'Emry & Thorington 1982:fig. 14';

	TEXT   CHARACTER = 209 TEXT = '(M221) position of the sustentacular facet relative to the ectal facet---(0) anteromedial to and separated from the ectal facet by sulcus (e.g., Castor), (1) sustentacular facet directly medial to ectal facet (e.g., Ochotona).';
	TEXT   TAXON = 68 CHARACTER = 209 TEXT = 'Emry & Thorington 1982:fig. 14';

	TEXT   TAXON = 68 CHARACTER = 210 TEXT = 'Emry & Thorington 1982:fig. 16';

	TEXT   CHARACTER = 211 TEXT = '(M223) cuboid length---(0) long axis shorter than that of astragalus (e.g., Castor), (1) cuboid long axis longer than that of astragalus (e.g., Rhynchocyon).';
	TEXT   TAXON = 68 CHARACTER = 211 TEXT = 'Emry & Thorington 1982:fig. 16';

	TEXT   TAXON = 3 CHARACTER = 212 TEXT = 'medial (1st) 1st cuneiform is elongate and extends proximally to cup the distal astragalus medially. Possibly this represents a fusion but as reported by Hildebrand 1978:fig.3 no separate ossification for medial tarsal sesamoid is evident in Anomalurus UMZC E1414.';

	TEXT   CHARACTER = 213 TEXT = '(M225; Meng et al. 2004: fig. 10) plantar process of navicular---(0) short (e.g., Castor), (1) elongate, approaching or exceeding size of articular surface for the astragalus (e.g., Lepus).';
	TEXT   TAXON = 88 CHARACTER = 213 TEXT = 'based on fig. 14 of Rose & Chinnery 2004 (Bulletin Carnegie Museum #36)';

	TEXT   CHARACTER = 214 TEXT = 'adapted from M226: digital rays---(0) weight bearing with distal phalanx extending distally to metatarsal-phalangeal joint adjacent digit (e.g., Didelphis), (1) distal phalanx terminating proximal or adjacent to metatarsal-phalangeal joint of adjacent digit (e.g., Dipodomys).';
	TEXT   TAXON = 16 CHARACTER = 214 TEXT = 'Dipodomys and Heliscomys shows digit I proximal phalanx terminate proximal to tip of digit II metatarsal. Digit V in both taxa is slightly longer, with proximal phalanx for V terminating coincident with the distal end of digit IV metatarsal in Heliscomys. Both I and V in Dipodomys and Heliscomys terminate proximal to the end of proximal digits II-IV. Asher et al. 2005 used "weight bearing" as criterion to code a given digit as "reduced". This applies to digits II-III of macropodids, but is less certain for Heliscomys & Dipodomys. Thus recode so that either reduced weight-bearing in macropodids or shortened digit in heteromyids qualify as "reduced".';
	TEXT   TAXON = 46 CHARACTER = 214 TEXT = 'see fig. 12N in Senter & Moch 2012 PeerJ, https://doi.org/10.7717/peerj.1439/fig-12';
	TEXT   TAXON = 73 CHARACTER = 214 TEXT = 'Dipodomys and Heliscomys shows digit I proximal phalanx terminate proximal to tip of digit II metatarsal. Digit V in both taxa is slightly longer, with proximal phalanx for V terminating coincident with the distal end of digit IV metatarsal in Heliscomys. Both I and V in Dipodomys and Heliscomys terminate proximal to the end of proximal digits II-IV. Asher et al. 2005 used "weight bearing" as criterion to code a given digit as "reduced". This applies to digits II-III of macropodids, but is less certain for Heliscomys & Dipodomys. Thus recode so that either reduced weight-bearing in macropodids or shortened digit in heteromyids qualify as "reduced".';

	TEXT   TAXON = 19 CHARACTER = 215 TEXT = 'see Fig. 2 in Schwerman et al. 2012, Palaeobio Palaeoenv (2012) 92:29–43';

	TEXT   TAXON = 19 CHARACTER = 216 TEXT = 'see Fig. 2 in Schwerman et al. 2012, Palaeobio Palaeoenv (2012) 92:29–43';

	TEXT   TAXON = 19 CHARACTER = 217 TEXT = 'see Fig. 2 in Schwerman et al. 2012, Palaeobio Palaeoenv (2012) 92:29–43';

	TEXT   TAXON = 16 CHARACTER = 218 TEXT = 'Dipodomys and Heliscomys shows digit I proximal phalanx terminate proximal to tip of digit II metatarsal. Digit V in both taxa is slightly longer, with proximal phalanx for V terminating coincident with the distal end of digit IV metatarsal in Heliscomys. Both I and V in Dipodomys and Heliscomys terminate proximal to the end of proximal digits II-IV. Asher et al. 2005 used "weight bearing" as criterion to code a given digit as "reduced". This applies to digits II-III of macropodids, but is less certain for Heliscomys & Dipodomys. Thus recode so that either reduced weight-bearing in macropodids or shortened digit in heteromyids qualify as "reduced".';
	TEXT   TAXON = 19 CHARACTER = 218 TEXT = 'see Fig. 2 in Schwerman et al. 2012, Palaeobio Palaeoenv (2012) 92:29–43';
	TEXT   TAXON = 46 CHARACTER = 218 TEXT = 'see p. 865 in Parsons 1898 Proc Zool Soc London 858-890';

	TEXT   CHARACTER = 219 TEXT = '(A184) metatarsal length---(0) not more than 200% proximal phalanx length (e.g., Didelphis), (1) at least twice the length of proximal phalanges (e.g., Lepus).';
	TEXT   TAXON = 43 CHARACTER = 219 TEXT = 'proximal phalanges unusually short, but metatarsals are still shorter than combined length of prox-phalanx to claw digit III.';
	TEXT   TAXON = 68 CHARACTER = 219 TEXT = 'Emry & Thorington 1982:fig. 16';

END;

